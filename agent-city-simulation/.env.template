# Agent City Simulation - Environment Configuration Template
# Copy this file to .env.local for local development
# Copy this file to .env.gcp for GCP production

# =============================================================================
# DEPLOYMENT ENVIRONMENT
# =============================================================================
ENVIRONMENT=local  # local, staging, production
DEBUG=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agent_city
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=  # Leave empty for local, set for production

# =============================================================================
# MESSAGE QUEUE CONFIGURATION
# =============================================================================
# Local: Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=agent-city

# GCP: Pub/Sub (only for GCP deployment)
GCP_PROJECT_ID=your-gcp-project-id
PUBSUB_EMULATOR_HOST=  # Only for local emulation

# =============================================================================
# AI/ML API KEYS
# =============================================================================
# Anthropic Claude (required for agent cognition)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# OpenAI (optional, backup)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# FINANCIAL TRADING APIs
# =============================================================================
# Alpaca Trading API (recommended for beginners)
ALPACA_API_KEY=PKxxxxxxxxxxxxxxxxxxxxx
ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxx
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Paper trading
# ALPACA_BASE_URL=https://api.alpaca.markets  # Live trading (CAREFUL!)

# Interactive Brokers (optional, advanced)
IB_ACCOUNT=
IB_HOST=
IB_PORT=
IB_CLIENT_ID=

# =============================================================================
# MARKET DATA APIs
# =============================================================================
# Polygon.io (recommended)
POLYGON_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Alpha Vantage (free alternative)
ALPHA_VANTAGE_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Yahoo Finance (free, no key needed, but less reliable)
YAHOO_FINANCE_ENABLED=true

# =============================================================================
# NEWS AND SENTIMENT APIs
# =============================================================================
# NewsAPI
NEWS_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Twitter API v2
TWITTER_API_KEY=xxxxxxxxxxxxxxxxxxxxx
TWITTER_API_SECRET=xxxxxxxxxxxxxxxxxxxxx
TWITTER_BEARER_TOKEN=xxxxxxxxxxxxxxxxxxxxx

# Reddit API
REDDIT_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx
REDDIT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx
REDDIT_USER_AGENT=AgentCityBot/1.0

# =============================================================================
# GOOGLE TRENDS
# =============================================================================
# No API key needed, but rate-limited
GOOGLE_TRENDS_ENABLED=true

# =============================================================================
# ECONOMIC DATA
# =============================================================================
# Federal Reserve Economic Data (FRED) - free
FRED_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# World Bank API - no key needed
WORLD_BANK_ENABLED=true

# =============================================================================
# GEOGRAPHIC DATA
# =============================================================================
# Mapbox (for cartographer)
MAPBOX_API_KEY=pk.xxxxxxxxxxxxxxxxxxxxx

# OpenStreetMap - no key needed
OSM_ENABLED=true

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
# Sentry (error tracking)
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxx

# Log Level
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=true
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# API Gateway
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000

# =============================================================================
# MODULE CONFIGURATION
# =============================================================================
# Identity Generator
IDENTITY_GEN_PORT=8001
IDENTITY_GEN_CACHE_SIZE=1000

# Cartographer
CARTOGRAPHER_PORT=8002
CITY_SIZE=medium  # small, medium, large
CITY_POPULATION=50000

# Orchestrator
ORCHESTRATOR_PORT=8003
MAX_AGENTS=300
AGENT_HEARTBEAT_INTERVAL=30  # seconds

# Predictor
PREDICTOR_PORT=8004
PREDICTION_INTERVAL=3600  # seconds (1 hour)

# Ranker
RANKER_PORT=8005

# Data Integration
DATA_INTEGRATION_PORT=8006
API_RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# DEPARTMENT CONFIGURATION
# =============================================================================
# R&D Department
RD_ENABLED=true
RD_AGENT_COUNT=10
RD_RESEARCH_INTERVAL=1800  # seconds (30 minutes)

# Builders Department
BUILDERS_ENABLED=true
BUILDERS_AGENT_COUNT=10

# Stockbrokers Department
STOCKBROKERS_ENABLED=false  # Start disabled for safety
STOCKBROKERS_AGENT_COUNT=10
TRADING_MODE=paper  # paper or live
MAX_CAPITAL_PER_AGENT=500  # USD
DAILY_LOSS_LIMIT=50  # USD per agent
MAX_POSITION_SIZE=100  # USD per trade

# =============================================================================
# SECURITY
# =============================================================================
# JWT Secret for API authentication
JWT_SECRET=CHANGE_ME_random_secret_here_min_32_chars

# API Key for dashboard access
DASHBOARD_API_KEY=CHANGE_ME

# Enable/disable authentication
REQUIRE_AUTH=false  # Set true for production

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# Worker threads
WORKER_THREADS=4

# Database connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Cache TTL (seconds)
CACHE_TTL=300

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Enable detailed metrics
ENABLE_DETAILED_METRICS=true

# Enable agent memory persistence
ENABLE_AGENT_MEMORY=true

# =============================================================================
# GCP-SPECIFIC (for GCP deployment)
# =============================================================================
# Cloud SQL
CLOUD_SQL_CONNECTION_NAME=your-project:region:instance

# Cloud Storage
GCS_BUCKET=your-bucket-name

# =============================================================================
# BACKUP AND RECOVERY
# =============================================================================
# Backup interval (hours)
BACKUP_INTERVAL=24

# Backup retention (days)
BACKUP_RETENTION=30

# Backup location
BACKUP_PATH=/backups

# =============================================================================
# NOTES
# =============================================================================
# - Never commit .env.local or .env.gcp to version control
# - Use strong passwords in production
# - Start with paper trading before live trading
# - Monitor API costs regularly
# - Review logs for any unusual activity
